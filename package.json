{
  "name": "open_aider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "node --import tsx apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/update-schema-contract.mjs --check && node --import tsx scripts/capability-output-contracts.ts --check && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests",
    "setup:dev": "node scripts/setup-dev.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed:test": "node --import tsx scripts/seed.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "budget:check": "node --import tsx scripts/check-model-budget.ts",
    "verify:requirements": "node --import tsx scripts/verify-requirements.ts",
    "verify:release": "node --import tsx scripts/verify-release.ts",
    "test:unit": "node scripts/run-tests.mjs vitest run tests/unit",
    "test:integration": "node scripts/run-tests.mjs vitest run tests/integration",
    "test:contract": "node scripts/run-tests.mjs vitest run tests/contract",
    "test:security": "node scripts/run-tests.mjs vitest run tests/security",
    "test:chaos": "node scripts/run-tests.mjs vitest run tests/chaos",
    "test:e2e": "node scripts/run-tests.mjs playwright test",
    "test:live": "node --import tsx scripts/live.ts",
    "test:coverage": "node scripts/run-tests.mjs vitest run --coverage",
    "snapshot:sources": "node scripts/snapshot-sources.mjs",
    "sbom": "pnpm licenses list --json > reports/licenses.json",
    "start:worker": "node --import tsx apps/worker/src/main.ts",
    "start:ingress": "node --import tsx apps/ingress/src/main.ts",
    "start:notifier": "node --import tsx apps/notifier/src/main.ts",
    "tenant:register": "node --import tsx scripts/register-tenant.ts",
    "test:prepare": "node --import tsx scripts/test-environment.ts",
    "test": "node scripts/run-tests.mjs vitest run",
    "start:maintenance": "node --import tsx apps/maintenance/src/main.ts",
    "schema:check": "node scripts/update-schema-contract.mjs --check",
    "schema:refresh": "node scripts/update-schema-contract.mjs --write",
    "permissions:install": "node --import tsx scripts/install-permission-manifest.ts",
    "contracts:check": "node --import tsx scripts/capability-output-contracts.ts --check",
    "formal:runtime": "node --import tsx scripts/formal-runtime.ts",
    "db:migrate:test-existing": "node --import tsx scripts/migrate-isolated-test.ts",
    "test:self-dm": "node scripts/test-self-dm.mjs",
    "start:scheduler": "node --import tsx apps/scheduler/src/main.ts",
    "operations:backup": "node --import tsx scripts/project-backup.ts",
    "operations:restore": "node --import tsx scripts/project-restore.ts",
    "operations:verify-restore": "node --import tsx scripts/restore-verification.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "react-dom": "19.3.0",
    "@fastify/helmet": "13.2.0",
    "pg": "8.23.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.0",
    "pg-boss": "12.38.0",
    "zod": "4.6.7",
    "@fastify/static": "10.1.6",
    "dingtalk-stream": "2.1.5",
    "exceljs": "4.4.0",
    "decimal.js": "10.6.0",
    "kysely": "0.29.6",
    "pdfkit": "0.20.2",
    "docx": "9.11.0",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "fast-check": "4.10.2",
    "testcontainers": "12.2.1",
    "@types/pdfkit": "0.17.6"
  },
  "pnpm": {
    "overrides": {
      "exceljs@4.4.0>uuid": "11.1.1"
    }
  }
}
