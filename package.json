{
  "name": "dingtalk-agent",
  "version": "0.1.0",
  "private": true,
  "description": "DingTalk Stream gateway with native reasoning, dynamic ReAct harness and AI Card streaming",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "isolated-vm"
    ]
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@alicloud/dingtalk": "^2.2.48",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "isolated-vm": "^7.0.1",
    "openai": "^7.45.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.9"
  }
}
