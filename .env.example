# ==================== 配置模板 ====================
# 复制为 .env 后按中文说明填写；本文件只放占位值，禁止写入真实密钥。

# ==================== 运行时 ====================
# 运行环境：development（本地）/ production（线上）
NODE_ENV=development
# 日志级别：trace / debug / info / warn / error
LOG_LEVEL=info
# 运行期状态根目录（插件安装、项目快照与索引等），相对路径基于项目根目录
AGENT_STATE_DIR=.state
# 工具工作区根目录（deliver_artifact 与沙箱共享），相对路径基于项目根目录
AGENT_WORKSPACE_DIR=.workspace

# ==================== PostgreSQL ====================
# 业务数据库连接串（会话、配置、用量、审计、技能与项目数据）
DATABASE_URL=postgres://localhost:5432/dingtalk_agent

# ==================== 钉钉应用 ====================
# 企业内部应用 AppKey
DINGTALK_CLIENT_ID=
# 企业内部应用 AppSecret，仅保存在 .env
DINGTALK_CLIENT_SECRET=
# 机器人编码，通常与 AppKey 相同
DINGTALK_ROBOT_CODE=
# 机器人管理员 StaffId；与 ADMIN_STAFF_IDS 合并生效
DINGTALK_ADMIN=

# ==================== 钉钉 AI 卡片 ====================
# AI 卡片模板 ID，模板场景必须为「AI 卡片」
DINGTALK_CARD_TEMPLATE_ID=
# 卡片布局：ai（单 content 流式字段）/ v1 / v2（多变量模板）
DINGTALK_CARD_LAYOUT=ai
# ai 布局下的流式字段名，需与卡片模板变量一致
DINGTALK_CARD_CONTENT_KEY=content
# 是否在卡片中展示思维链与工具细节；状态角标始终展示
DINGTALK_CARD_SHOW_THINKING=false

# ==================== 钉钉机器人表情 ====================
# 处理问题期间在用户消息上贴表情，回答交付后撤回
DINGTALK_BOT_EMOTION_ENABLED=true
# 贴的表情名（钉钉表情列表英文文案，Like 即「赞」）
DINGTALK_BOT_EMOTION_NAME=Like

# ==================== 大模型 ====================
# 模型配置来源：env = 按角色读取下列 .env 配置（推荐）；database = 兼容旧版，允许控制台保存的模型覆盖
LLM_MODEL_SOURCE=env

# --- 供应商密钥：角色配置通过 ${VAR} 引用，只需在这里录入一次 ---
# DeepSeek 密钥（默认模型）
DEEPSEEK_API_KEY=
# Kimi / Moonshot 密钥（管理员单聊、子代理硬任务）
KIMI_API_KEY=
# 智谱密钥（旁听/主动回复/视觉/联网搜索）
GLM_API_KEY=

# --- 默认角色：普通员工单聊、群聊 @、全量 ReAct ---
# 模型协议：openai-compatible 或 anthropic
LLM_PROVIDER=openai-compatible
# OpenAI 兼容接口地址（通常带 /v1）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型密钥，接口与审计中只显示掩码
LLM_API_KEY=${DEEPSEEK_API_KEY}
# 默认模型名称：DeepSeek V4.1 Flash 的 API ID 为 deepseek-flash
LLM_MODEL=deepseek-flash
# 采样温度
LLM_TEMPERATURE=0.3
# 思维链强度：off / auto / low / high / max
LLM_THINKING=high
# 单次输出 token 上限；留空使用供应商默认
LLM_MAX_TOKENS=8192
# 供应商方言：openai / deepseek / moonshot / zhipu；留空按 BASE_URL 自动识别
LLM_DIALECT=
# 兼容旧变量：LLM_THINKING 未设置时，false 等价 off，true 等价 auto
LLM_ENABLE_NATIVE_REASONING=true

# --- 管理员单聊 / 子代理硬任务：Kimi ---
# 留空任意一项时该角色回退默认模型，启动日志会给出回退原因
LLM_ADMIN_PROVIDER=openai-compatible
LLM_ADMIN_BASE_URL=https://api.moonshot.cn/v1
LLM_ADMIN_API_KEY=${KIMI_API_KEY}
LLM_ADMIN_MODEL=kimi-k3.1-pro
# Kimi 固定温度 1.0，适配器会省略 temperature 参数
LLM_ADMIN_TEMPERATURE=1
LLM_ADMIN_THINKING=max
LLM_ADMIN_MAX_TOKENS=8192
LLM_ADMIN_DIALECT=

# --- 旁听分类 / 主动回复 / 规划与记忆摘要：GLM ---
LLM_PROACTIVE_PROVIDER=openai-compatible
LLM_PROACTIVE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_PROACTIVE_API_KEY=${GLM_API_KEY}
LLM_PROACTIVE_MODEL=glm-5.3-flash
LLM_PROACTIVE_TEMPERATURE=0.3
# GLM-5.3 系列强制思考，不能关闭；low 可显著降低旁听分类与主动回复延迟
LLM_PROACTIVE_THINKING=low
LLM_PROACTIVE_MAX_TOKENS=4096
LLM_PROACTIVE_DIALECT=

# ==================== 联网搜索 ====================
# 是否向模型暴露 web_search 工具；控制台也可在线开关
WEB_SEARCH_ENABLED=true
# 搜索接口地址；留空时按大模型是否指向智谱自动选择智谱地址
WEB_SEARCH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 搜索接口密钥；留空时优先复用 GLM_API_KEY / LLM_PROACTIVE_API_KEY
WEB_SEARCH_API_KEY=
# 搜索引擎：search_std / search_pro / search_pro_sogou / search_pro_quark
WEB_SEARCH_ENGINE=search_pro
# 单次返回条数 1-50；搜狗引擎仅支持 10/20/30/40/50
WEB_SEARCH_COUNT=5
# 摘要长度：medium / high
WEB_SEARCH_CONTENT_SIZE=medium
# 搜索请求超时（毫秒）
WEB_SEARCH_TIMEOUT_MS=12000
# 出站前脱敏手机号、邮箱、证件号与常见密钥格式
WEB_SEARCH_REDACT=true
# 相同查询结果缓存秒数；0 表示关闭缓存
WEB_SEARCH_CACHE_TTL_SECONDS=300
# 每个会话每小时真实 API 调用上限；0 表示不限
WEB_SEARCH_MAX_CALLS_PER_HOUR=30
# 每个进程每个自然日真实 API 调用上限；0 表示不限
WEB_SEARCH_DAILY_LIMIT=500

# ==================== 公网链接读取 ====================
# 是否向模型暴露 web_fetch 工具，用于打开群聊/单聊中的公开链接
WEB_FETCH_ENABLED=true
# 单页请求超时（毫秒）
WEB_FETCH_TIMEOUT_MS=12000
# 单页响应体上限（MB），默认 2 MB
WEB_FETCH_MAX_MB=2
# 单次返回正文默认字符数，工具参数可在 500-3200 之间调整
WEB_FETCH_MAX_CHARS=2500
# 可选：独立 DNS 服务器 IP（逗号分隔），用于绕开本地代理返回的 fake-IP；留空使用系统 DNS
# 例如 Clash/Surge 的 fake-ip 模式下可填 223.5.5.5,119.29.29.29
WEB_FETCH_DNS_SERVERS=
# 相同链接结果缓存秒数；0 表示关闭缓存
WEB_FETCH_CACHE_TTL_SECONDS=600
# 每个会话每小时调用上限；0 表示不限
WEB_FETCH_MAX_CALLS_PER_HOUR=20
# 每个进程每个自然日调用上限；0 表示不限
WEB_FETCH_DAILY_LIMIT=300

# ==================== 人设 ====================
# 机器人名称
PERSONA_NAME=小钉
# 人设 Prompt
PERSONA_ROLE_PROMPT=你是企业内部智能助手，负责解答员工的工作问题，回答准确、简洁、可执行。
# 语气与表达风格
PERSONA_SPEAKING_STYLE=语气专业友好，先给结论再给要点；不确定时明确说明而不是编造。

# ==================== 推理循环 ====================
# 单轮任务墙钟上限（毫秒），超过会拒接并停止
LOOP_MAX_WALL_TIME_MS=900000
# 单轮任务 Token 预算，超过会拒接并停止
LOOP_MAX_TOTAL_TOKENS=120000
# 同一工具同参数连续调用上限，超过视为原地打转
LOOP_MAX_CONSECUTIVE_SAME_TOOL=2
# 是否启用信息收敛自检
LOOP_CONVERGENCE_CHECK=true
# 单次工具调用（含 MCP）最长等待秒数；需小于 MCP 配置的 timeoutMs
TOOL_TIMEOUT_SECONDS=300

# ==================== 记忆 ====================
# 每次上下文携带的最近消息条数
MEMORY_WINDOW_MESSAGES=20
# 情景压缩触发阈值（Token），超过后归档最早的一部分消息
MEMORY_COMPRESSION_THRESHOLD_TOKENS=12000
# 每次压缩归档的最早消息比例（0.1-0.9）
MEMORY_COMPRESSION_RATIO=0.6
# 每次组装上下文时的语义召回条数上限
MEMORY_SEMANTIC_LIMIT=6

# ==================== 群聊旁听 / 主动回复 ====================
# 是否缓存群消息并启用旁听
BYSTANDER_ENABLED=true
# 是否允许非 @ 主动回复
BYSTANDER_PROACTIVE_REPLY=true
# 旁听滑动窗口大小（条）
BYSTANDER_SLIDING_WINDOW_SIZE=20
# 同一群两次主动回复的最小间隔（秒）
BYSTANDER_COOLDOWN_SECONDS=180
# 主动回复置信度阈值（0-1）
BYSTANDER_CONFIDENCE_THRESHOLD=0.82
# 触发主动回复的重点主题（逗号分隔）；留空使用内置默认主题
BYSTANDER_TRIGGER_TOPICS=线上故障,SQL查询,接口报错,发布排期
# 疑似提问后的防抢答等待窗口（毫秒）
BYSTANDER_DEBOUNCE_MS=8000
# 是否用 DWS 个人事件长连接接收非 @ 群消息
BYSTANDER_LISTEN_ENABLED=true
# 额外监听的群 openConversationId（逗号分隔；群策略开启旁听时自动纳入）
BYSTANDER_LISTEN_GROUPS=
# 忽略的发送者名称或 ID（逗号分隔），避免机器人自问自答
BYSTANDER_LISTEN_IGNORE_SENDERS=
# 等待 Stream 路径先处理 @ 消息的秒数，再做旁听判定
BYSTANDER_LISTEN_SETTLE_SECONDS=3
# 从数据库重载群监听白名单的间隔（秒）
BYSTANDER_LISTEN_REFRESH_SECONDS=60

# ==================== 管理控制台 / ChatOps ====================
# 管理 API Bearer Token；留空则本地开放访问，生产必须设置
ADMIN_API_TOKEN=
# 管理 API 与控制台端口（同时托管 web-console/dist）
ADMIN_PORT=8787
# 允许在单聊使用 admin_* 工具的员工 StaffId（逗号分隔，与 DINGTALK_ADMIN 合并）
ADMIN_STAFF_IDS=

# ==================== DWS / 沙箱 / MCP ====================
# 是否暴露 DWS CLI 工具源（控制台也可在线开关）
DWS_CLI_ENABLED=false
# dws 可执行文件路径；默认 shebang 使用错误 Node 时可指向包装脚本
DWS_BINARY=dws
# 每位员工的 DWS home 根目录（0700 目录，文件 DEK 加密令牌）
DWS_PROFILE_ROOT=.state/dws-profiles
# 设备登录绑定的企业 corpId；设置后只允许该组织账号
DWS_CORP_ID=
# 是否暴露隔离沙盒工具（JavaScript 走 isolated-vm，其他语言走 Docker）
SANDBOX_ENABLED=true
# 启动时加载的 MCP 服务定义文件；之后修改持久化到 sys_configs
MCP_SERVERS_CONFIG=config/mcp-servers.json

# ==================== 企业 MCP ====================
# 企业 MCP 地址，供 config/mcp-servers.json 以环境变量占位符引用
ENTERPRISE_MCP_ENDPOINT=mcp地址
# 企业 MCP 访问令牌，供 config/mcp-servers.json 以环境变量占位符引用
ENTERPRISE_MCP_TOKEN=对方给你的令牌

# ==================== 用量配额与模型路由 ====================
# 是否启用每日 Token 配额；用量流水始终记录
USAGE_QUOTA_ENABLED=false
# 单员工每自然日 Token 上限，0 表示不限
USAGE_DAILY_TOKENS_PER_USER=0
# 单群每自然日 Token 上限，0 表示不限
USAGE_DAILY_TOKENS_PER_CONVERSATION=0
# 模型路由已改为上面的角色配置（LLM_* / LLM_ADMIN_* / LLM_PROACTIVE_*）；
# 旧版 LLM_ROUTE_* 不再生效，可安全删除

# ==================== 向量语义记忆 ====================
# 是否启用 pgvector 语义召回；关闭时使用关键词召回
EMBEDDING_ENABLED=false
# 向量接口地址；留空沿用 LLM_BASE_URL
EMBEDDING_BASE_URL=
# 向量接口密钥；留空沿用 LLM_API_KEY
EMBEDDING_API_KEY=
# 向量模型名称
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度，需与模型输出一致
EMBEDDING_DIMENSIONS=1536

# ==================== 企业术语库 ====================
# 是否把高频术语注入系统提示词（内容在控制台维护）
GLOSSARY_PROMPT_ENABLED=true
# 系统提示注入条数上限（最大 100）
GLOSSARY_PROMPT_LIMIT=80
# 每个问题召回的术语卡上限（最大 10）
GLOSSARY_RETRIEVAL_LIMIT=4

# ==================== 技能 / 插件 / 项目 ====================
# 是否挂载技能目录与 skill_* 工具
EXTENSIONS_SKILLS_ENABLED=true
# 是否启用声明式插件的安装与运行时合并
EXTENSIONS_PLUGINS_ENABLED=true
# 是否挂载项目工具、项目同步与项目手册
EXTENSIONS_PROJECTS_ENABLED=true
# 未点名项目时使用的默认项目 ID；留空由模型选择
EXTENSIONS_DEFAULT_PROJECT_ID=
# 注入系统提示的技能目录条数（1-50）
SKILL_CATALOG_LIMIT=20
# 注入系统提示的项目简报最大字符数（200-8000）
PROJECT_BRIEF_MAX_CHARS=2000
# 随仓库发布的内置技能目录
SKILLS_BUILTIN_DIR=skills/builtin
# 团队自建技能目录，支持在线编辑与热重载
SKILLS_LOCAL_DIR=skills/local
# 插件 stdio MCP 允许的裸命令（逗号分隔）；留空使用 npx,uvx,node,python3,docker
PLUGIN_ALLOWED_COMMANDS=
# 缺少必需密钥时是否允许先安装；允许时插件保持禁用
PLUGIN_ALLOW_MISSING_SECRETS=false
# 本地项目来源允许读取的额外根目录（逗号分隔）；留空只允许仓库根目录
PROJECT_ALLOWED_ROOTS=
# 项目种子目录，启动时导入且不覆盖控制台修改
PROJECT_SEED_DIR=projects
# 未设置 autoSyncMinutes 的项目的兜底自动同步间隔（秒）
PROJECT_SYNC_INTERVAL_SECONDS=900

# ==================== GitHub 只读工具 ====================
# 开启后向模型暴露 github_* 只读工具；修改后需重启进程
GITHUB_ENABLED=false
# 仅从环境变量读取，不落库、不回显；代码搜索需要它
GITHUB_TOKEN=
# 必须是 HTTPS 且位于默认白名单或 GITHUB_ALLOWED_HOSTS
GITHUB_API_BASE=https://api.github.com
# GitHub Enterprise 代理额外允许的主机名（逗号分隔）
GITHUB_ALLOWED_HOSTS=
# 重复读取的 ETag/304 缓存秒数（0 关闭，最大 300）
GITHUB_CACHE_TTL_SECONDS=300

# ==================== 多模态与产物交付 ====================
# 入站图片先由视觉模型描述再交给文本模型
VISION_ENABLED=false
# 视觉接口地址；建议保留智谱地址
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 视觉接口密钥；留空时复用 GLM_API_KEY
VISION_API_KEY=${GLM_API_KEY}
# 视觉模型名称
VISION_MODEL=glm-5.3-flash
# 入站附件大小上限（MB）
ATTACHMENT_MAX_MB=20
# 是否暴露 deliver_artifact，让智能体回传工作区文件
ARTIFACT_DELIVERY_ENABLED=true
# 产物回传大小上限（MB）
ARTIFACT_MAX_MB=20
# deliver_artifact 额外允许的目录（逗号分隔，相对项目根目录）
ARTIFACT_ROOTS=

# ==================== 写操作确认 ====================
# 写/破坏性 MCP 工具是否需要 /confirm 确认
TOOL_CONFIRMATION_ENABLED=true
# 待确认操作的有效期（秒）
TOOL_CONFIRMATION_TTL_SECONDS=300

# ==================== Planner / 子代理 ====================
# 长问题或工具较多时，是否在 ReAct 循环前先产出 3-7 步计划
PLANNER_ENABLED=false
# 触发规划的用户问题最小字符数
PLANNER_MIN_CHARS=80
# 触发规划的最小可用工具数（与字符数条件取或）
PLANNER_MIN_TOOLS=8
# 是否暴露 delegate_research，派发只读子代理做专题检索
SUBAGENT_ENABLED=false
# 单个子代理的墙钟上限（秒）
SUBAGENT_TIMEOUT_SECONDS=90
# 单个子代理的 Token 预算
SUBAGENT_MAX_TOKENS=20000

# ==================== 多实例部署（可选） ====================
# 通过 PostgreSQL advisory lock 选主；仅 leader 消费 Stream
CLUSTER_ENABLED=false
# 选主锁名，同时用于共享状态表的命名空间
CLUSTER_LOCK_KEY=dingtalk-agent
# standby 重新抢主的间隔（秒）
CLUSTER_RETRY_SECONDS=5
# leader 续约心跳间隔（秒）
CLUSTER_HEARTBEAT_SECONDS=10
# 从共享配置表拉取其他实例变更的间隔（秒）
CLUSTER_CONFIG_POLL_SECONDS=30

# ==================== 数据治理 ====================
# 日志与 ReAct 轨迹落库前脱敏手机号、邮箱、身份证号与常见密钥格式
DATA_REDACTION_ENABLED=true
# 会话消息与情景摘要保留天数
RETENTION_MESSAGES_DAYS=180
# ReAct 轨迹保留天数
RETENTION_TRACES_DAYS=90
# 入站附件目录保留小时数
RETENTION_ATTACHMENTS_HOURS=24
# 管理审计日志保留天数
RETENTION_AUDIT_DAYS=365
# 用量流水保留天数
RETENTION_USAGE_DAYS=365
# 定时清理间隔（秒）；集群模式下仅 leader 执行
DATA_CLEANUP_INTERVAL_SECONDS=86400
# 定时清理只统计不删除，适合上线前观察
DATA_CLEANUP_DRY_RUN=false
