# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://localhost:5432/dingtalk_agent

# ---------- DingTalk Stream / Robot ----------
# AppKey / AppSecret of the DingTalk internal app (Stream mode, no public callback needed)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Robot code shown in the open platform (usually equals AppKey)
DINGTALK_ROBOT_CODE=

# ---------- DingTalk AI Card ----------
# AI card template id created in the DingTalk card platform; the template needs
# three variables: thinking_section, answer_section, status_bar
DINGTALK_CARD_TEMPLATE_ID=

# ---------- LLM (OpenAI compatible: DeepSeek / GLM / Qwen / etc.) ----------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-reasoner
LLM_TEMPERATURE=0.3
LLM_ENABLE_NATIVE_REASONING=true

# ---------- Persona ----------
PERSONA_NAME=小钉
PERSONA_ROLE_PROMPT=你是企业内部智能助手，负责解答员工的工作问题，回答准确、简洁、可执行。
PERSONA_SPEAKING_STYLE=语气专业友好，先给结论再给要点；不确定时明确说明而不是编造。

# ---------- Dynamic loop policy ----------
LOOP_MAX_WALL_TIME_MS=120000
LOOP_MAX_TOTAL_TOKENS=64000
LOOP_MAX_CONSECUTIVE_SAME_TOOL=2
LOOP_CONVERGENCE_CHECK=true

# ---------- Memory ----------
MEMORY_WINDOW_MESSAGES=20
