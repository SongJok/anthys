# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://localhost:5432/dingtalk_agent

# ---------- DingTalk Stream / Robot ----------
# AppKey / AppSecret of the DingTalk internal app (Stream mode, no public callback needed)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Robot code shown in the open platform (usually equals AppKey)
DINGTALK_ROBOT_CODE=
# Bot admin StaffId; same effect as ADMIN_STAFF_IDS, and can also be edited in the admin console
DINGTALK_ADMIN=

# ---------- DingTalk AI Card ----------
# AI card template id created in the DingTalk card platform. The template scenario
# must be "AI 卡片"; streaming only works on its single content field.
DINGTALK_CARD_TEMPLATE_ID=
# Card layout: ai (single content streaming field, default) / v1 / v2 (multi-variable templates)
DINGTALK_CARD_LAYOUT=ai
# Streaming variable name used by the ai layout; must match the AI card template
DINGTALK_CARD_CONTENT_KEY=content
# Show the concrete chain-of-thought in the ai card; off by default, the status
# line (思考中/调用工具/已完成) stays visible either way
DINGTALK_CARD_SHOW_THINKING=false

# ---------- DingTalk bot emotion reply ----------
# While a question is being processed the bot reacts with an emoji on the user's
# message and recalls it when the answer is delivered. Set to false to disable.
DINGTALK_BOT_EMOTION_ENABLED=true
# Emotion name from the DingTalk expression list (Like = 赞)
DINGTALK_BOT_EMOTION_NAME=Like

# ---------- LLM (OpenAI compatible: DeepSeek / GLM / Qwen / etc.) ----------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-reasoner
LLM_TEMPERATURE=0.3
LLM_ENABLE_NATIVE_REASONING=true

# ---------- Persona ----------
PERSONA_NAME=小钉
PERSONA_ROLE_PROMPT=你是企业内部智能助手，负责解答员工的工作问题，回答准确、简洁、可执行。
PERSONA_SPEAKING_STYLE=语气专业友好，先给结论再给要点；不确定时明确说明而不是编造。

# ---------- Dynamic loop policy ----------
# 超过任一上限时机器人会拒接该需求并停止执行
LOOP_MAX_WALL_TIME_MS=900000
LOOP_MAX_TOTAL_TOKENS=120000
LOOP_MAX_CONSECUTIVE_SAME_TOOL=2
LOOP_CONVERGENCE_CHECK=true

# ---------- Memory ----------
MEMORY_WINDOW_MESSAGES=20
# Episodic compression: trigger above this token count, archive the earliest ratio
MEMORY_COMPRESSION_THRESHOLD_TOKENS=12000
MEMORY_COMPRESSION_RATIO=0.6
# Semantic recall limit per assembled context
MEMORY_SEMANTIC_LIMIT=6

# ---------- Group bystander / proactive reply ----------
# Buffer every group message and allow non-@ proactive replies
BYSTANDER_ENABLED=true
BYSTANDER_PROACTIVE_REPLY=true
BYSTANDER_SLIDING_WINDOW_SIZE=20
BYSTANDER_COOLDOWN_SECONDS=180
BYSTANDER_CONFIDENCE_THRESHOLD=0.82
BYSTANDER_TRIGGER_TOPICS=线上故障,SQL查询,接口报错,发布排期
# Anti-interruption wait before answering a suspected non-@ question
BYSTANDER_DEBOUNCE_MS=8000

# ---------- Admin console / ChatOps ----------
# Bearer token for /api/v1/admin/*; empty disables auth locally
ADMIN_API_TOKEN=
# Port of the Hono admin REST API (also serves web-console/dist)
ADMIN_PORT=8787
# Comma separated DingTalk StaffIds allowed to use admin_* tools in single chat (merged with DINGTALK_ADMIN)
ADMIN_STAFF_IDS=
# Expose the DWS CLI tool source (can also be toggled online)
DWS_CLI_ENABLED=false
# Path to the dws executable; point to a wrapper if the default shebang uses the wrong Node
DWS_BINARY=dws
# Expose the isolated sandbox tool (JavaScript via isolated-vm, other languages via Docker)
SANDBOX_ENABLED=true
# MCP server definitions used on boot; later edits persist in sys_configs
MCP_SERVERS_CONFIG=config/mcp-servers.json

# ---------- Enterprise MCP ----------
# Referenced by config/mcp-servers.json as ${ENTERPRISE_MCP_ENDPOINT}
ENTERPRISE_MCP_ENDPOINT=mcp地址
ENTERPRISE_MCP_TOKEN=对方给你的令牌

# ---------- Usage quota & model routing ----------
# Enforce per-user / per-group daily token quotas (usage ledger is always recorded)
USAGE_QUOTA_ENABLED=false
USAGE_DAILY_TOKENS_PER_USER=0
USAGE_DAILY_TOKENS_PER_CONVERSATION=0
# Optional per-scenario model override; empty keeps LLM_MODEL
LLM_ROUTE_DEFAULT_MODEL=
LLM_ROUTE_PROACTIVE_MODEL=
LLM_ROUTE_ADMIN_MODEL=

# ---------- Vector semantic memory ----------
# Enable pgvector embeddings for semantic recall; defaults to keyword recall when off
EMBEDDING_ENABLED=false
# Defaults to LLM_BASE_URL / LLM_API_KEY when empty
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- Enterprise glossary ----------
# Inject top-N high-frequency terms into the system prompt (admin page manages content)
GLOSSARY_PROMPT_ENABLED=true
# Max injected terms, capped at 100
GLOSSARY_PROMPT_LIMIT=80
# Max term cards retrieved per question, capped at 10
GLOSSARY_RETRIEVAL_LIMIT=4

# ---------- Multimodal inbound & artifact delivery ----------
# Describe inbound images with a vision model before handing to the text model
VISION_ENABLED=false
# Defaults to LLM_BASE_URL / LLM_API_KEY / LLM_MODEL when empty
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# Inbound attachment size limit (MB)
ATTACHMENT_MAX_MB=20
# Expose the deliver_artifact tool so the agent can send workspace files back
ARTIFACT_DELIVERY_ENABLED=true
ARTIFACT_MAX_MB=20
# Extra directories allowed for deliver_artifact (comma separated, relative to project root)
ARTIFACT_ROOTS=

# ---------- Write-action confirmation ----------
# Gate write/destructive MCP tools behind /confirm; set false to let them run directly
TOOL_CONFIRMATION_ENABLED=true
# How long a pending action stays valid before it is discarded
TOOL_CONFIRMATION_TTL_SECONDS=300

# ---------- Planner / subagent ----------
# Emit a 3-7 step plan before the ReAct loop for long questions or large tool sets
PLANNER_ENABLED=false
# Only plan when the user question is at least this many characters
PLANNER_MIN_CHARS=80
# ...or when the agent exposes at least this many tools
PLANNER_MIN_TOOLS=8
# Expose delegate_research so the agent can spawn a read-only subagent
SUBAGENT_ENABLED=false
SUBAGENT_TIMEOUT_SECONDS=90
SUBAGENT_MAX_TOKENS=20000

# ---------- Multi-instance deployment (optional) ----------
# Elect a single active stream consumer via a Postgres advisory lock; standby serves health/admin only
CLUSTER_ENABLED=false
CLUSTER_LOCK_KEY=dingtalk-agent
CLUSTER_RETRY_SECONDS=5
CLUSTER_HEARTBEAT_SECONDS=10
CLUSTER_CONFIG_POLL_SECONDS=30

# ---------- Data governance ----------
# Mask phone/email/ID-card/secret patterns in logs and ReAct traces
DATA_REDACTION_ENABLED=true
# Retention windows (days unless noted)
RETENTION_MESSAGES_DAYS=180
RETENTION_TRACES_DAYS=90
RETENTION_ATTACHMENTS_HOURS=24
RETENTION_AUDIT_DAYS=365
RETENTION_USAGE_DAYS=365
# Scheduled cleanup interval; leader-only in cluster mode
DATA_CLEANUP_INTERVAL_SECONDS=86400
# Set true to only report what would be deleted
DATA_CLEANUP_DRY_RUN=false
