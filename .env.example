APP_NAME=anthys
APP_ENV=development
APP_ORIGIN=http://localhost:64700
PORT=64700
RELEASE_PROFILE=ENTERPRISE_DWS
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN
DATABASE_URL_FILE=.secrets/database_url
MIGRATION_DATABASE_URL_FILE=.secrets/migration_database_url
RUNTIME_DATABASE_URL_FILE=.secrets/runtime_database_url
QUEUE_DATABASE_URL_FILE=.secrets/queue_database_url
APP_MASTER_KEY_FILE=.secrets/app_master_key
SESSION_SECRET_FILE=.secrets/session_secret
# Development bootstrap: `node deploy/setup-dev-secrets.mjs` imports the two
# secrets below (or their *_FILE references) from this .env and writes 0600
# copies under .secrets/docker for the Compose secret mounts. Containers read
# only /run/secrets/*; raw values are not added to the Compose environment.
# Non-secret identifiers reach Compose only when it is started with
# `--env-file .env` (deploy/dev-up.sh does this). Never commit .env.
DINGTALK_TENANT_ID=
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
# Fill either the raw value or the *_FILE path; *_FILE wins when both are set.
# The DINGTALK_APP_SECRET alias is also supported. Docker uses the imported file.
DINGTALK_CLIENT_SECRET=
DINGTALK_CLIENT_SECRET_FILE=
DINGTALK_ROBOT_CODE=
DINGTALK_CARD_TEMPLATE_ID=
# Host-side path for non-Docker runs. Compose always reads the file from the
# app_data volume as /data/card-template.json; missing keeps text delivery.
DINGTALK_CARD_TEMPLATE_FILE=.data/card-template.json
FILE_STORE_ROOT=.data/files
# Exact enterprise-reviewed CDN hostnames, comma separated. Empty disables remote attachment fetching.
ATTACHMENT_DOWNLOAD_HOSTS=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# Fill either the raw value or the *_FILE path; *_FILE wins when both are set.
# The AIDER_AI_DEFAULT_API_KEY alias is also supported. Docker uses the imported file.
GLM_API_KEY=
GLM_API_KEY_FILE=
GLM_REASONING_EFFORT=high
# Administrator-approved JSON policy, validated offline with pnpm budget:check.
# Missing or invalid policy blocks model dispatch; never substitute test ceilings.
BUDGET_POLICY_FILE=
# DWS needs a separately deployed pinned runner and a reviewed 0600 config that
# is readable inside the app container. Credentials in .env alone do not enable
# DWS; unsupported local modes fail closed with DWS_RUNNER_SERVICE_REQUIRED.
DWS_ENABLED=false
DWS_BINARY_PATH=/opt/dws/dws
DWS_RUNNER_URL=
DWS_RUNNER_AUTH_KEY_FILE=
SANDBOX_ENABLED=false
# Compose "sandbox" profile host-side settings (not app secrets). The broker
# config, HMAC key and Ed25519 keypair are generated by:
#   node deploy/setup-sandbox-broker.mjs --build
# Only the broker container may mount /var/run/docker.sock; API/worker never do.
ANTHYS_SANDBOX_BROKER_IMAGE=anthys-sandbox-broker:dev
ANTHYS_SANDBOX_SECRETS_DIR=.secrets/sandbox-broker
# Numeric gid of /var/run/docker.sock on the host (Docker Desktop is often 0).
ANTHYS_DOCKER_SOCKET_GID=0
MOCK_PROVIDERS=false
LIVE_TEST_ENABLED=false

# Optional restriction: only current session replies; blocks proactive fallback
# before token exchange and disables notifier card sends. Does not grant access.
DINGTALK_REPLY_ONLY=false

# Reviewed upstream company-MCP configs. In Docker these are container paths:
# /run/company-mcp/<name>.json backed by host files in .secrets/company-mcp/
# (or ANTHYS_PRIVATE_MCP_DIR). Host-relative paths do not exist in containers.
# Optional reviewed read-only proxy contract. Generic chat credentials never enable code access.
COMPANY_MCP_CONFIG_FILE=

# Separate reviewed log proxy, actor/resource/redaction/egress scope; disabled when unset.
COMPANY_LOGS_MCP_CONFIG_FILE=

# Separate reviewed data-template proxy; unset keeps company.data.query UNCONFIGURED.
# Config pins server/tool/input-schema hash and certified template registry hash;
# its 0600 tokenFile is resolved from this config, never from AIDER_AI_* values.
COMPANY_DATA_MCP_CONFIG_FILE=

# Linux pinned DWS runner only; still requires individual authorization and approved egress.
DWS_RUNNER_CONFIG_FILE=

# Optional reviewed classification/expiry/size policy for private preference model use.
# Empty keeps private preference context disabled; user consent alone does not enable egress.
PRIVATE_MEMORY_MODEL_POLICY_FILE=

# Optional one-shot DM restriction; loading a profile does not arm a slot.
# Needs an explicitly provisioned immutable DB record and separately approved
# budget policy. Empty cannot reopen an existing trial. No real trial approved.
# Trial and formal profiles are mutually exclusive. Formal requires schema69,
# a separately reviewed persisted authorization and a private 0600 profile.
FORMAL_RUNTIME_PROFILE_FILE=
ONE_SHOT_TRIAL_PROFILE_FILE=
