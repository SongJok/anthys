APP_NAME=open_aider
APP_ENV=development
APP_ORIGIN=http://localhost:52330
PORT=52330
RELEASE_PROFILE=ENTERPRISE_DWS
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_LOCALE=zh-CN
DATABASE_URL_FILE=.secrets/database_url
MIGRATION_DATABASE_URL_FILE=.secrets/migration_database_url
RUNTIME_DATABASE_URL_FILE=.secrets/runtime_database_url
QUEUE_DATABASE_URL_FILE=.secrets/queue_database_url
APP_MASTER_KEY_FILE=.secrets/app_master_key
SESSION_SECRET_FILE=.secrets/session_secret
DINGTALK_TENANT_ID=
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET_FILE=
DINGTALK_ROBOT_CODE=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CARD_TEMPLATE_FILE=.data/card-template.json
FILE_STORE_ROOT=.data/files
# Exact enterprise-reviewed CDN hostnames, comma separated. Empty disables remote attachment fetching.
ATTACHMENT_DOWNLOAD_HOSTS=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_API_KEY_FILE=
GLM_REASONING_EFFORT=high
# Administrator-approved JSON policy, validated offline with pnpm budget:check.
# Missing or invalid policy blocks model dispatch; never substitute test ceilings.
BUDGET_POLICY_FILE=
DWS_ENABLED=false
DWS_BINARY_PATH=/opt/dws/dws
DWS_RUNNER_URL=
DWS_RUNNER_AUTH_KEY_FILE=
SANDBOX_ENABLED=false
MOCK_PROVIDERS=false
LIVE_TEST_ENABLED=false

# Optional restriction: only current session replies; blocks proactive fallback
# before token exchange and disables notifier card sends. Does not grant access.
DINGTALK_REPLY_ONLY=false

# Optional reviewed read-only proxy contract. Generic chat credentials never enable code access.
COMPANY_MCP_CONFIG_FILE=

# Separate reviewed log proxy, actor/resource/redaction/egress scope; disabled when unset.
COMPANY_LOGS_MCP_CONFIG_FILE=

# Linux pinned DWS runner only; still requires individual authorization and approved egress.
DWS_RUNNER_CONFIG_FILE=

# Optional reviewed classification/expiry/size policy for private preference model use.
# Empty keeps private preference context disabled; user consent alone does not enable egress.
PRIVATE_MEMORY_MODEL_POLICY_FILE=

# Optional one-shot DM restriction; loading a profile does not arm a slot.
# Needs an explicitly provisioned immutable DB record and separately approved
# budget policy. Empty cannot reopen an existing trial. No real trial approved.
# Trial and formal profiles are mutually exclusive. Formal requires schema69,
# a separately reviewed persisted authorization and a private 0600 profile.
FORMAL_RUNTIME_PROFILE_FILE=
ONE_SHOT_TRIAL_PROFILE_FILE=
