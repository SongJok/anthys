{
  "servers": [
    {
      "id": "enterprise",
      "name": "企业 AI 中台",
      "domain": "general",
      "transport": "streamable-http",
      "endpointOrCommand": "${ENTERPRISE_MCP_ENDPOINT}",
      "envOrHeaders": {
        "authorization": "Bearer ${ENTERPRISE_MCP_TOKEN}"
      },
      "timeoutMs": 480000,
      "maxResultChars": 16000
    },
    {
      "id": "amap",
      "name": "高德地图",
      "domain": "general",
      "transport": "streamable-http",
      "endpointOrCommand": "https://mcp.amap.com/mcp?key=${AMAP_WEB_KEY}",
      "timeoutMs": 30000,
      "maxResultChars": 16000,
      "enabled": false
    },
    {
      "id": "playwright",
      "name": "浏览器自动化（仅本地）",
      "domain": "code",
      "transport": "stdio",
      "endpointOrCommand": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--output-dir",
        ".workspace/playwright-mcp",
        "--blocked-origins",
        "http://127.0.0.1:*;https://127.0.0.1:*;http://localhost:*;https://localhost:*;http://[::1]:*;https://[::1]:*;http://0.0.0.0:*;http://169.254.169.254:*;https://169.254.169.254:*;http://100.100.100.200:*;http://metadata.google.internal:*;http://*.local:*;http://*.internal:*"
      ],
      "timeoutMs": 60000,
      "maxResultChars": 16000,
      "enabled": false
    }
  ]
}
