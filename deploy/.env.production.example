# ---------- Runtime ----------
NODE_ENV=production
LOG_LEVEL=info
# 运行期状态根目录（插件安装、项目快照与索引等）；相对路径基于应用目录
AGENT_STATE_DIR=.state
# 工具工作区根目录（deliver_artifact 与沙箱共享）；相对路径基于应用目录
AGENT_WORKSPACE_DIR=.workspace

# ---------- PostgreSQL（自建，仅监听本机） ----------
# 密码含特殊字符时用 URL 编码
DATABASE_URL=postgres://anthys:CHANGE_ME@127.0.0.1:5432/dingtalk_agent

# ---------- DingTalk Stream / Robot ----------
# Stream 模式为出站长连接，服务器无需公网入站端口
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
# 管理员 StaffId，可多个用逗号分隔；也可在控制台里改
DINGTALK_ADMIN=
ADMIN_STAFF_IDS=

# ---------- DingTalk AI Card ----------
# 模板场景必须是「AI 卡片」，流式只写 content 字段
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CARD_LAYOUT=ai
DINGTALK_CARD_CONTENT_KEY=content
DINGTALK_CARD_SHOW_THINKING=false
DINGTALK_BOT_EMOTION_ENABLED=true
DINGTALK_BOT_EMOTION_NAME=Like

# ---------- LLM：按角色路由 ----------
# env = 以本文件为准；database = 允许控制台保存的模型覆盖
LLM_MODEL_SOURCE=env
# 供应商密钥：下面的角色配置通过 ${VAR} 引用，只需录入一次
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
# 默认角色：员工单聊、群聊 @ 与全量 ReAct（DeepSeek V4.1 Flash）
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_THINKING=high
LLM_MAX_TOKENS=8192
LLM_DIALECT=
# 管理员单聊与子代理（Kimi K3.1 Pro）；任一必填项缺失时回退默认角色
LLM_ADMIN_PROVIDER=openai-compatible
LLM_ADMIN_BASE_URL=https://api.moonshot.cn/v1
LLM_ADMIN_API_KEY=${KIMI_API_KEY}
LLM_ADMIN_MODEL=kimi-k3.1-pro
LLM_ADMIN_TEMPERATURE=1
LLM_ADMIN_THINKING=max
LLM_ADMIN_MAX_TOKENS=8192
LLM_ADMIN_DIALECT=
# 旁听分类、主动回复、规划器与记忆摘要（GLM-5.3-Flash）
LLM_PROACTIVE_PROVIDER=openai-compatible
LLM_PROACTIVE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_PROACTIVE_API_KEY=${GLM_API_KEY}
LLM_PROACTIVE_MODEL=glm-5.3-flash
LLM_PROACTIVE_TEMPERATURE=0.3
# GLM-5.3 系列强制思考，不能关闭；low 可降低旁听与主动回复延迟
LLM_PROACTIVE_THINKING=low
LLM_PROACTIVE_MAX_TOKENS=4096
LLM_PROACTIVE_DIALECT=
# 兼容旧变量：仅在未设置 LLM_THINKING 时生效
LLM_ENABLE_NATIVE_REASONING=true

# ---------- Public web search ----------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=search_pro
WEB_SEARCH_COUNT=5
WEB_SEARCH_CONTENT_SIZE=medium
WEB_SEARCH_TIMEOUT_MS=12000
WEB_SEARCH_REDACT=true
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_MAX_CALLS_PER_HOUR=30
WEB_SEARCH_DAILY_LIMIT=500

# ---------- Persona ----------
PERSONA_NAME=小钉
PERSONA_ROLE_PROMPT=你是企业内部智能助手，负责解答员工的工作问题，回答准确、简洁、可执行。
PERSONA_SPEAKING_STYLE=语气专业友好，先给结论再给要点；不确定时明确说明而不是编造。

# ---------- Dynamic loop policy ----------
LOOP_MAX_WALL_TIME_MS=900000
LOOP_MAX_TOTAL_TOKENS=120000
LOOP_MAX_CONSECUTIVE_SAME_TOOL=2
LOOP_MAX_ITERATIONS=40
LOOP_MAX_PARALLEL_TOOLS=4
LOOP_CONVERGENCE_CHECK=true
TOOL_TIMEOUT_SECONDS=300

# ---------- Memory ----------
MEMORY_WINDOW_MESSAGES=20
MEMORY_COMPRESSION_THRESHOLD_TOKENS=12000
MEMORY_COMPRESSION_RATIO=0.6
MEMORY_SEMANTIC_LIMIT=6

# ---------- Group bystander / proactive reply ----------
BYSTANDER_ENABLED=true
BYSTANDER_PROACTIVE_REPLY=true
BYSTANDER_SLIDING_WINDOW_SIZE=20
BYSTANDER_COOLDOWN_SECONDS=180
BYSTANDER_CONFIDENCE_THRESHOLD=0.82
BYSTANDER_TRIGGER_TOPICS=线上故障,SQL查询,接口报错,发布排期
BYSTANDER_DEBOUNCE_MS=8000
# 依赖服务器上安装 dws CLI 并完成设备码登录，否则旁听与 DWS 工具不可用
BYSTANDER_LISTEN_ENABLED=true
BYSTANDER_LISTEN_GROUPS=
BYSTANDER_LISTEN_IGNORE_SENDERS=
BYSTANDER_LISTEN_SETTLE_SECONDS=3
BYSTANDER_LISTEN_REFRESH_SECONDS=60

# ---------- Admin console / ChatOps ----------
# 必填：留空则 /api/v1/admin/* 不校验任何令牌
ADMIN_API_TOKEN=
ADMIN_PORT=8787
DWS_CLI_ENABLED=true
DWS_BINARY=dws
DWS_PROFILE_ROOT=.state/dws-profiles
DWS_CORP_ID=
# 沙盒：JS 走 isolated-vm，python/bash 走 Docker（需已安装并启动 docker）
SANDBOX_ENABLED=true
MCP_SERVERS_CONFIG=config/mcp-servers.json

# ---------- Enterprise MCP ----------
ENTERPRISE_MCP_ENDPOINT=
ENTERPRISE_MCP_TOKEN=

# ---------- Usage quota ----------
USAGE_QUOTA_ENABLED=false
USAGE_DAILY_TOKENS_PER_USER=0
USAGE_DAILY_TOKENS_PER_CONVERSATION=0
# 模型路由见上方 LLM_* / LLM_ADMIN_* / LLM_PROACTIVE_*；旧版 LLM_ROUTE_* 已移除

# ---------- Vector semantic memory ----------
# 启用后写入向量、召回走余弦距离；异常自动降级为关键词召回
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- Enterprise glossary ----------
GLOSSARY_PROMPT_ENABLED=true
GLOSSARY_PROMPT_LIMIT=80
GLOSSARY_RETRIEVAL_LIMIT=4

# ---------- Skills / Plugins / Projects ----------
EXTENSIONS_SKILLS_ENABLED=true
EXTENSIONS_PLUGINS_ENABLED=true
EXTENSIONS_PROJECTS_ENABLED=true
EXTENSIONS_DEFAULT_PROJECT_ID=
SKILL_CATALOG_LIMIT=20
PROJECT_BRIEF_MAX_CHARS=2000
SKILLS_BUILTIN_DIR=skills/builtin
SKILLS_LOCAL_DIR=skills/local
# 留空使用 npx,uvx,node,python3,docker
PLUGIN_ALLOWED_COMMANDS=
PLUGIN_ALLOW_MISSING_SECRETS=false
# local 来源项目可读目录；留空仅允许应用目录本身
PROJECT_ALLOWED_ROOTS=
PROJECT_SEED_DIR=projects
PROJECT_SYNC_INTERVAL_SECONDS=900

# ---------- GitHub read-only tools ----------
# 需要查看 GitHub 仓库 / Issue / PR 时开启
# 开启后向模型暴露 github_* 只读工具；修改后需重启进程，控制台「项目手册」页可查看真实状态并做连通性测试
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_ALLOWED_HOSTS=
GITHUB_CACHE_TTL_SECONDS=300

# ---------- Multimodal inbound & artifact delivery ----------
VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
ATTACHMENT_MAX_MB=20
ARTIFACT_DELIVERY_ENABLED=true
ARTIFACT_MAX_MB=20
ARTIFACT_ROOTS=

# ---------- Background job queue ----------
JOB_RUNNER_INTERVAL_SECONDS=5
JOB_LEASE_SECONDS=1800
JOB_MAX_CONCURRENCY=2

# ---------- Write-action confirmation ----------
TOOL_CONFIRMATION_ENABLED=true
TOOL_CONFIRMATION_TTL_SECONDS=300

# ---------- Planner / subagent ----------
PLANNER_ENABLED=false
PLANNER_MIN_CHARS=80
PLANNER_MIN_TOOLS=8
SUBAGENT_ENABLED=false
SUBAGENT_TIMEOUT_SECONDS=90
SUBAGENT_MAX_TOKENS=20000

# ---------- Multi-instance ----------
# 单实例部署保持 false；动态配置与旁听缓冲按单实例设计
CLUSTER_ENABLED=false
CLUSTER_LOCK_KEY=dingtalk-agent
CLUSTER_RETRY_SECONDS=5
CLUSTER_HEARTBEAT_SECONDS=10
CLUSTER_CONFIG_POLL_SECONDS=30

# ---------- Data governance ----------
DATA_REDACTION_ENABLED=true
RETENTION_MESSAGES_DAYS=180
RETENTION_TRACES_DAYS=90
RETENTION_ATTACHMENTS_HOURS=24
RETENTION_AUDIT_DAYS=365
RETENTION_USAGE_DAYS=365
DATA_CLEANUP_INTERVAL_SECONDS=86400
DATA_CLEANUP_DRY_RUN=false
